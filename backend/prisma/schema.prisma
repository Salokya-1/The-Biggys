// The Biggys — RTE Integrated Management System
// Schema v2: v1 (records, results, seating) + sections, academic calendar, timetable,
// change/absence requests, exam kinds with invigilators, fees and admit cards.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MODULE_LEADER
  LECTURER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  DEFERRED
  WITHDRAWN
  GRADUATED
}

enum Standing {
  GOOD
  RESIT
  REVIEW
}

enum MarkSheetStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  CORRECTION_REQUESTED
}

enum Outcome {
  PASS
  FAIL
  RESIT
  DEFERRED
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  DISCARDED
}

enum AdjacencyMode {
  ROW
  ROW_AND_COLUMN
}

enum Term {
  AUTUMN
  SPRING
  SUMMER
}

enum ExamKind {
  FINAL
  CLASS_TEST
  RESIT
}

enum SeatingMode {
  MIXED
  BY_ID
}

enum ExceptionKind {
  CANCELLED
  TEACHER_CHANGE
  ROOM_CHANGE
  RESCHEDULED
}

enum RequestKind {
  TEACHER_ABSENCE
  STUDENT_ABSENCE
  SECTION_SWAP
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the person who raised it, before anyone decided.
  CANCELLED
}

enum FeeStatus {
  UNPAID
  PAID
  WAIVED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean   @default(true)
  /// Per-user overrides on top of the role matrix: { "grant": ["fees.write"], "revoke": ["student.write"] }
  permissions  Json?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student             Student?
  ledModules          Module[]                @relation("ModuleLeader")
  lecturedOfferings   ModuleOffering[]        @relation("OfferingLecturer")
  coLecturedOfferings ModuleOffering[]        @relation("OfferingCoLecturer")
  cameraRequests      CameraAccessRequest[]   @relation("CameraRequester")
  supportClasses      SupportClass[]          @relation("SupportClassTeacher")
  raisedClassAlerts   ClassAlert[]            @relation("ClassAlertRaisedBy")
  coveredClassAlerts  ClassAlert[]            @relation("ClassAlertCover")
  unavailability      TeacherUnavailability[]
  submittedSheets     MarkSheet[]             @relation("SheetSubmitter")
  approvedSheets      MarkSheet[]             @relation("SheetApprover")
  publishedSheets     MarkSheet[]             @relation("SheetPublisher")
  importBatches       ImportBatch[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  taughtSlots         TimetableSlot[]         @relation("SlotTeacher")
  coverSlots          SlotException[]         @relation("ExceptionTeacher")
  requests            ChangeRequest[]         @relation("Requester")
  broadcasts          Broadcast[]             @relation("BroadcastSender")
  sentMessages        DirectMessage[]         @relation("MessageFrom")
  receivedMessages    DirectMessage[]         @relation("MessageTo")
  raisedQueries       QueryTicket[]           @relation("QueryRaisedBy")
  answeredQueries     QueryTicket[]           @relation("QueryAnsweredBy")
  markedAttendance    AttendanceRecord[]      @relation("AttendanceMarkedBy")
  decidedRequests     ChangeRequest[]         @relation("Decider")
  invigilations       ExamInvigilator[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Programme {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  level String

  intakes    Intake[]
  modules    Module[]
  students   Student[]
  broadcasts Broadcast[]
}

model Intake {
  id          String   @id @default(cuid())
  programmeId String
  label       String
  startDate   DateTime

  programme Programme  @relation(fields: [programmeId], references: [id])
  semesters Semester[]
  students  Student[]
  sections  Section[]

  @@unique([programmeId, label])
}

/// Autumn / Spring: 12 teaching weeks then a 2-week exam window (14 weeks). Summer: retakes.
model Semester {
  id            String    @id @default(cuid())
  intakeId      String
  number        Int
  term          Term      @default(AUTUMN)
  startDate     DateTime
  endDate       DateTime
  teachingWeeks Int       @default(12)
  examStart     DateTime? // defaults to startDate + teachingWeeks
  examEnd       DateTime? // defaults to examStart + 2 weeks

  intake          Intake             @relation(fields: [intakeId], references: [id])
  offerings       ModuleOffering[]
  currentStudents Student[]          @relation("CurrentSemester")
  slots           TimetableSlot[]
  examSessions    ExamSession[]
  feeInvoices     FeeInvoice[]
  admitCards      AdmitCard[]
  attendance      AttendanceRecord[]

  @@unique([intakeId, number])
}

/// A class group of ~22–25 students within an intake (A, B, C …). Timetables are per section.
model Section {
  id       String @id @default(cuid())
  intakeId String
  name     String

  intake       Intake          @relation(fields: [intakeId], references: [id])
  students     Student[]
  slots        TimetableSlot[]
  combinedInto TimetableSlot[] @relation("SlotGroups")
  swapRequests ChangeRequest[] @relation("TargetSection")
  examSessions ExamSession[]

  @@unique([intakeId, name])
}

model Student {
  id                  String        @id @default(cuid())
  userId              String?       @unique
  studentId           String        @unique // institutional ID, e.g. 23012345
  name                String
  email               String?
  programmeId         String
  intakeId            String
  sectionId           String?
  currentSemesterId   String?
  status              StudentStatus @default(ACTIVE)
  standing            Standing      @default(GOOD)
  specialNeedsSeating Boolean       @default(false)
  deletedAt           DateTime? // soft delete
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user              User?              @relation(fields: [userId], references: [id])
  programme         Programme          @relation(fields: [programmeId], references: [id])
  intake            Intake             @relation(fields: [intakeId], references: [id])
  section           Section?           @relation(fields: [sectionId], references: [id])
  currentSemester   Semester?          @relation("CurrentSemester", fields: [currentSemesterId], references: [id])
  enrollments       Enrollment[]
  supportClasses    SupportClass[]     @relation("SupportClassStudents")
  seatAllocations   SeatAllocation[]
  feeInvoices       FeeInvoice[]
  admitCards        AdmitCard[]
  attendanceRecords AttendanceRecord[]

  @@index([programmeId, intakeId, status])
  @@index([sectionId])
  @@index([name])
}

model Module {
  id             String  @id @default(cuid())
  /// Module codes are London Met codes; the same code can be delivered on more than one programme.
  code           String
  title          String
  credits        Int
  semesterNumber Int
  programmeId    String
  moduleLeaderId String?

  programme    Programme        @relation(fields: [programmeId], references: [id])
  moduleLeader User?            @relation("ModuleLeader", fields: [moduleLeaderId], references: [id])
  offerings    ModuleOffering[]

  @@unique([programmeId, code])
  @@index([code])
}

model ModuleOffering {
  id           String  @id @default(cuid())
  moduleId     String
  semesterId   String
  lecturerId   String?
  // Every module is staffed by two teachers; sections are shared between them.
  coLecturerId String?

  module            Module                @relation(fields: [moduleId], references: [id])
  semester          Semester              @relation(fields: [semesterId], references: [id])
  lecturer          User?                 @relation("OfferingLecturer", fields: [lecturerId], references: [id])
  coLecturer        User?                 @relation("OfferingCoLecturer", fields: [coLecturerId], references: [id])
  components        AssessmentComponent[]
  enrollments       Enrollment[]
  markSheets        MarkSheet[]
  examSessions      ExamSession[]
  seatAllocations   SeatAllocation[]
  slots             TimetableSlot[]
  supportClasses    SupportClass[]
  attendanceRecords AttendanceRecord[]

  @@unique([moduleId, semesterId])
}

model Enrollment {
  id               String    @id @default(cuid())
  studentId        String
  moduleOfferingId String
  attempt          Int       @default(1) // 1 | 2 | 3
  isResit          Boolean   @default(false)
  deletedAt        DateTime? // soft delete
  createdAt        DateTime  @default(now())

  student        Student        @relation(fields: [studentId], references: [id])
  moduleOffering ModuleOffering @relation(fields: [moduleOfferingId], references: [id])
  marks          Mark[]
  results        Result[]

  @@unique([studentId, moduleOfferingId, attempt])
  @@index([moduleOfferingId])
}

// ---------------------------------------------------------------------------
// Assessment & results
// ---------------------------------------------------------------------------

model AssessmentComponent {
  id                String @id @default(cuid())
  moduleOfferingId  String
  name              String
  weight            Int // percentage; weights per offering must sum to 100 (validated in service)
  maxMark           Int
  componentPassMark Int?
  sortOrder         Int    @default(0)

  moduleOffering ModuleOffering @relation(fields: [moduleOfferingId], references: [id])
  marks          Mark[]

  @@unique([moduleOfferingId, name])
}

/// Configurable — seeded with defaults that are labelled as assumptions until confirmed.
model GradingScheme {
  id        String  @id @default(cuid())
  name      String  @unique
  passMark  Int     @default(40)
  resitCap  Int     @default(40)
  bands     Json // e.g. [{ "grade": "A", "min": 70 }, ...]
  isDefault Boolean @default(false)

  markSheets MarkSheet[]
}

model MarkSheet {
  id                 String          @id @default(cuid())
  moduleOfferingId   String
  status             MarkSheetStatus @default(DRAFT)
  version            Int             @default(1)
  gradingSchemeId    String?
  submittedById      String?
  approvedById       String?
  publishedById      String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  rejectReason       String?
  lockVersion        Int             @default(0) // optimistic concurrency
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  moduleOffering ModuleOffering @relation(fields: [moduleOfferingId], references: [id])
  gradingScheme  GradingScheme? @relation(fields: [gradingSchemeId], references: [id])
  submittedBy    User?          @relation("SheetSubmitter", fields: [submittedById], references: [id])
  approvedBy     User?          @relation("SheetApprover", fields: [approvedById], references: [id])
  publishedBy    User?          @relation("SheetPublisher", fields: [publishedById], references: [id])
  marks          Mark[]
  results        Result[]
  importBatches  ImportBatch[]

  @@unique([moduleOfferingId, version])
  @@index([status])
}

model Mark {
  id           String   @id @default(cuid())
  markSheetId  String
  enrollmentId String
  componentId  String
  rawMark      Decimal? @db.Decimal(6, 2) // NULL when absent / not yet entered
  isAbsent     Boolean  @default(false)
  note         String?
  updatedAt    DateTime @updatedAt

  markSheet  MarkSheet           @relation(fields: [markSheetId], references: [id], onDelete: Cascade)
  enrollment Enrollment          @relation(fields: [enrollmentId], references: [id])
  component  AssessmentComponent @relation(fields: [componentId], references: [id])

  @@unique([markSheetId, enrollmentId, componentId])
  @@index([enrollmentId])
}

/// Immutable per mark-sheet version: a correction creates a new version, never edits a row.
model Result {
  id               String   @id @default(cuid())
  enrollmentId     String
  markSheetId      String
  markSheetVersion Int
  overallMark      Decimal  @db.Decimal(6, 2)
  grade            String
  outcome          Outcome
  computedAt       DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  markSheet  MarkSheet  @relation(fields: [markSheetId], references: [id])

  @@unique([markSheetId, enrollmentId])
  @@index([enrollmentId])
}

model ImportBatch {
  id           String       @id @default(cuid())
  markSheetId  String
  fileName     String
  uploadedById String
  rowsTotal    Int
  rowsValid    Int
  rowsInvalid  Int
  errors       Json // per-row [{ row, studentId, component, level, message }]
  rows         Json // parsed rows kept for commit
  status       ImportStatus @default(PREVIEW)
  createdAt    DateTime     @default(now())

  markSheet  MarkSheet @relation(fields: [markSheetId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])
}

// ---------------------------------------------------------------------------
// Timetable (one constant weekly routine repeated for the teaching weeks)
// ---------------------------------------------------------------------------

model TimetableSlot {
  id               String    @id @default(cuid())
  semesterId       String
  sectionId        String
  moduleOfferingId String
  teacherId        String
  venueId          String?
  kind             ClassKind @default(LECTURE)
  dayOfWeek        Int // 1 = Monday … 7 = Sunday (the teaching week is Sun–Fri)
  startTime        String // "09:00"
  endTime          String // "10:30"
  weekFrom         Int       @default(1)
  weekTo           Int       @default(12)
  createdAt        DateTime  @default(now())

  semester          Semester              @relation(fields: [semesterId], references: [id])
  section           Section               @relation(fields: [sectionId], references: [id])
  moduleOffering    ModuleOffering        @relation(fields: [moduleOfferingId], references: [id])
  teacher           User                  @relation("SlotTeacher", fields: [teacherId], references: [id])
  venue             Venue?                @relation(fields: [venueId], references: [id])
  exceptions        SlotException[]
  requests          ChangeRequest[]
  cameraRequests    CameraAccessRequest[] @relation("SlotCameraRequests")
  alerts            ClassAlert[]
  /// Every group in the room. A lecture combines the whole cohort (C1+C2+…); a tutorial or
  /// workshop has the one group in `section`.
  groups            Section[]             @relation("SlotGroups")
  attendanceRecords AttendanceRecord[]

  @@index([semesterId, sectionId])
  @@index([teacherId, dayOfWeek])
  @@index([venueId, dayOfWeek])
}

/// A one-off change to a slot on a specific date (cover teacher, room move, cancellation, reschedule).
model SlotException {
  id          String        @id @default(cuid())
  slotId      String
  date        DateTime
  kind        ExceptionKind
  teacherId   String?
  venueId     String?
  startTime   String?
  endTime     String?
  reason      String
  createdById String?
  createdAt   DateTime      @default(now())

  slot    TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  teacher User?         @relation("ExceptionTeacher", fields: [teacherId], references: [id])
  venue   Venue?        @relation(fields: [venueId], references: [id])

  @@unique([slotId, date])
}

/// Absence and change requests from teachers and students, approved by RTE (or the module leader).
model ChangeRequest {
  id              String        @id @default(cuid())
  kind            RequestKind
  requesterId     String
  slotId          String?
  date            DateTime
  targetSectionId String?
  reason          String
  /// Automatic reason check: { "verdict": "OK|WEAK|GIBBERISH", "score": 0-100, "notes": [...], "checkedBy": "rules|ai" }
  reasonCheck     Json?
  status          RequestStatus @default(PENDING)
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime      @default(now())

  requester     User           @relation("Requester", fields: [requesterId], references: [id])
  decidedBy     User?          @relation("Decider", fields: [decidedById], references: [id])
  slot          TimetableSlot? @relation(fields: [slotId], references: [id])
  targetSection Section?       @relation("TargetSection", fields: [targetSectionId], references: [id])

  @@index([status, createdAt])
  @@index([requesterId])
}

// ---------------------------------------------------------------------------
// Examinations & seating
// ---------------------------------------------------------------------------

model ExamSession {
  id          String      @id @default(cuid())
  title       String
  kind        ExamKind    @default(FINAL)
  seatingMode SeatingMode @default(MIXED)
  semesterId  String?
  date        DateTime
  startTime   String // "09:00"
  durationMin Int
  seed        Int         @default(1) // deterministic seating
  generatedBy String? // "auto" | "manual"
  createdAt   DateTime    @default(now())

  semester        Semester?             @relation(fields: [semesterId], references: [id])
  offerings       ModuleOffering[]
  sections        Section[]
  venues          Venue[]
  seatAllocations SeatAllocation[]
  invigilators    ExamInvigilator[]
  cameraRequests  CameraAccessRequest[]

  @@index([date])
}

model ExamInvigilator {
  id            String @id @default(cuid())
  examSessionId String
  venueId       String
  userId        String

  examSession ExamSession @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  venue       Venue       @relation(fields: [venueId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([examSessionId, venueId, userId])
  @@index([userId])
}

model Venue {
  id            String        @id @default(cuid())
  name          String        @unique
  building      String
  rows          Int
  cols          Int
  disabledSeats Json          @default("[]") // [{ "row": 3, "col": 4 }, ...]
  adjacencyMode AdjacencyMode @default(ROW)
  isClassroom   Boolean       @default(true)
  /// What the room is for. Lectures need a hall or lecture theatre, workshops a lab, tutorials a
  /// seminar or tutorial room — the split Islington's own allocation sheet works to.
  roomType      RoomType      @default(TUTORIAL_ROOM)
  /// Optional drawn layout: { "cells": { "3:4": "AISLE" | "DESK" | "OFF" }, "labelMode": "ROW_LETTER" | "NUMERIC" }
  layout        Json?

  examSessions    ExamSession[]
  seatAllocations SeatAllocation[]
  slots           TimetableSlot[]
  slotExceptions  SlotException[]
  invigilations   ExamInvigilator[]
  cameraRequests  CameraAccessRequest[]
  supportClasses  SupportClass[]
}

model SeatAllocation {
  id               String   @id @default(cuid())
  examSessionId    String
  venueId          String
  studentId        String
  moduleOfferingId String
  row              Int
  col              Int
  seatLabel        String // "A1", "B12"
  runId            String
  createdAt        DateTime @default(now())

  examSession    ExamSession    @relation(fields: [examSessionId], references: [id], onDelete: Cascade)
  venue          Venue          @relation(fields: [venueId], references: [id])
  student        Student        @relation(fields: [studentId], references: [id])
  moduleOffering ModuleOffering @relation(fields: [moduleOfferingId], references: [id])

  @@unique([examSessionId, studentId])
  @@unique([examSessionId, venueId, row, col])
}

// ---------------------------------------------------------------------------
// Fees & admit cards
// ---------------------------------------------------------------------------

model FeeInvoice {
  id         String    @id @default(cuid())
  studentId  String
  semesterId String
  amount     Decimal   @db.Decimal(12, 2)
  currency   String    @default("NPR")
  status     FeeStatus @default(UNPAID)
  dueDate    DateTime
  paidAt     DateTime?
  method     String?
  reference  String?
  createdAt  DateTime  @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  @@unique([studentId, semesterId])
}

model AdmitCard {
  id         String   @id @default(cuid())
  studentId  String
  semesterId String
  cardNo     String   @unique
  issuedAt   DateTime @default(now())
  issuedById String?

  student  Student  @relation(fields: [studentId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])

  @@unique([studentId, semesterId])
}

// ---------------------------------------------------------------------------
// Audit & notifications
// ---------------------------------------------------------------------------

/// Append-only: no update/delete route exists and a DB trigger rejects UPDATE/DELETE.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. marksheet.approve
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// What a room is used for.
enum RoomType {
  HALL
  LECTURE_THEATRE
  TUTORIAL_ROOM
  SEMINAR_ROOM
  LAB
}

/// Lecture, tutorial or workshop. Each year of study has its own days for each kind.
enum ClassKind {
  LECTURE
  TUTORIAL
  WORKSHOP
}

/// A request to IT support for camera access to a room for the length of one class or exam.
/// Only the RTE admin may raise one; every request emails IT support and is kept for the record.
model CameraAccessRequest {
  id             String              @id @default(cuid())
  reference      String              @unique
  venueId        String
  examSessionId  String?
  slotId         String?
  date           DateTime
  startTime      String
  endTime        String
  reason         String
  status         CameraRequestStatus @default(PENDING)
  requestedById  String
  itSupportEmail String
  notifiedAt     DateTime?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime            @default(now())

  venue       Venue          @relation(fields: [venueId], references: [id])
  examSession ExamSession?   @relation(fields: [examSessionId], references: [id])
  slot        TimetableSlot? @relation("SlotCameraRequests", fields: [slotId], references: [id])
  requestedBy User           @relation("CameraRequester", fields: [requestedById], references: [id])

  @@index([status, date])
}

enum CameraRequestStatus {
  PENDING
  SENT
  APPROVED
  DENIED
}

/// Outbox for every message the system sends. Rows are kept even when SMTP is not configured, so
/// the trail of who was told what stays auditable and the demo can show it.
model EmailMessage {
  id          String      @id @default(cuid())
  to          String
  subject     String
  body        String
  status      EmailStatus @default(QUEUED)
  error       String?
  sentAt      DateTime?
  relatedType String?
  relatedId   String?
  createdAt   DateTime    @default(now())

  @@index([status, createdAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// An extra class laid on for the students of one module who are at risk, so the help goes to the
/// people who need it rather than being repeated to the whole cohort.
model SupportClass {
  id               String   @id @default(cuid())
  moduleOfferingId String
  teacherId        String
  venueId          String?
  date             DateTime
  startTime        String
  endTime          String
  reason           String
  createdById      String
  createdAt        DateTime @default(now())

  moduleOffering ModuleOffering @relation(fields: [moduleOfferingId], references: [id])
  teacher        User           @relation("SupportClassTeacher", fields: [teacherId], references: [id])
  venue          Venue?         @relation(fields: [venueId], references: [id])
  students       Student[]      @relation("SupportClassStudents")

  @@index([moduleOfferingId, date])
}

/// "Nobody has turned up to teach this." Raised by a student from their own timetable, it reaches
/// RTE immediately and, where a free teacher of that module exists, assigns cover on the spot.
model ClassAlert {
  id             String           @id @default(cuid())
  slotId         String
  date           DateTime
  kind           ClassAlertKind   @default(TEACHER_ABSENT)
  note           String?
  status         ClassAlertStatus @default(OPEN)
  raisedById     String
  coverId        String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())

  slot     TimetableSlot @relation(fields: [slotId], references: [id])
  raisedBy User          @relation("ClassAlertRaisedBy", fields: [raisedById], references: [id])
  cover    User?         @relation("ClassAlertCover", fields: [coverId], references: [id])

  @@index([status, date])
}

enum ClassAlertKind {
  TEACHER_ABSENT
  NO_TEACHER_ASSIGNED
  ROOM_PROBLEM
}

enum ClassAlertStatus {
  OPEN
  COVER_ASSIGNED
  RESOLVED
  DISMISSED
}

/// When a teacher cannot be timetabled. Part-time staff, industry days, a standing commitment —
/// the routine has to work around them, so they say so once and the generator respects it.
model TeacherUnavailability {
  id        String   @id @default(cuid())
  teacherId String
  dayOfWeek Int // 7 = Sunday, 1 = Monday … 5 = Friday
  startTime String
  endTime   String
  reason    String?
  createdAt DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
}

/// Who an announcement goes to.
enum BroadcastAudience {
  EVERYONE
  STUDENTS
  STAFF
  PROGRAMME
}

/// One announcement from RTE, fanned out to a notification per recipient.
///
/// The announcement is kept in its own right so the alerts page can show what was said, to whom
/// and when, long after the individual notifications have been read and cleared.
model Broadcast {
  id          String            @id @default(cuid())
  senderId    String
  audience    BroadcastAudience
  programmeId String?
  title       String
  body        String
  recipients  Int               @default(0)
  createdAt   DateTime          @default(now())

  sender    User       @relation("BroadcastSender", fields: [senderId], references: [id])
  programme Programme? @relation(fields: [programmeId], references: [id])

  @@index([createdAt])
}

/// Whether a student was in the room.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One student, one class, one day.
model AttendanceRecord {
  id         String           @id @default(cuid())
  studentId  String
  slotId     String
  offeringId String
  date       DateTime         @db.Date
  status     AttendanceStatus
  markedById String?
  createdAt  DateTime         @default(now())

  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot       TimetableSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  offering   ModuleOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  markedBy   User?          @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  semester   Semester?      @relation(fields: [semesterId], references: [id])
  semesterId String?

  @@unique([studentId, slotId, date])
  @@index([offeringId, date])
  @@index([studentId, status])
}

/// A message from one person to another inside the system.
///
/// Deliberately a flat table rather than threads and conversations: the whole feature is "find a
/// person, say something to them", and a thread is just the messages between two ids.
model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  from User @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, readAt])
  @@index([fromId, toId, createdAt])
}

/// Where a query sits.
enum QueryStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A question put to RTE that is not a request for a decision — "when do resits open?".
model QueryTicket {
  id           String      @id @default(cuid())
  raisedById   String
  category     String
  subject      String
  body         String
  status       QueryStatus @default(OPEN)
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  raisedBy   User  @relation("QueryRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  answeredBy User? @relation("QueryAnsweredBy", fields: [answeredById], references: [id])

  @@index([status, createdAt])
}
