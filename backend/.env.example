DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biggys?schema=public
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=dev-only-change-me-jwt-secret-32chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32
CORS_ORIGIN=http://localhost:3000
RUN_MIGRATIONS_ON_START=true

# AI assistant (OpenRouter). Leave empty to disable the assistant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
