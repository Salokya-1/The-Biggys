# Copy the relevant block into backend/.env and web/.env.local (both gitignored).
# Never commit real secrets. Production values live in the Antideploy / Vercel dashboards.

# ---------- backend/.env ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biggys?schema=public
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=dev-only-change-me-jwt-secret-32chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-32
CORS_ORIGIN=http://localhost:3000
RUN_MIGRATIONS_ON_START=true

# ---------- web/.env.local ----------
NEXT_PUBLIC_API_URL=http://localhost:8080
